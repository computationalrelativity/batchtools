#! /bin/bash
@(#SBATCH -d afterany:@CHAINED_JOB_ID@)@
#SBATCH -A @ALLOCATION@
#SBATCH --partition @QUEUE@
#SBATCH -t @WALLTIME@
#SBATCH -N @NODES@ 
#SBATCH --ntasks-per-node=@NUM_GPUS@
#SBATCH -J @SIMULATION_NAME@
#SBATCH --mail-type=ALL
#SBATCH --mail-user=@EMAIL@
#SBATCH -o @RUNDIR@/@SIMULATION_NAME@.out
#SBATCH -e @RUNDIR@/@SIMULATION_NAME@.err
#SBATCH --export=NONE
#SBATCH --ear=off

echo "Preparing:"
set -x                          # Output commands
cd @RUNDIR@

ml sw stack/latest
ml sw intel-toolkit/2025.1.0
ml cmake/4.3.3

export I_MPI_ADJUST_ALLREDUCE=6
SEGFAULT_LIB=/lib64/libSegFault.so
echo "Checking:"
pwd
hostname
date

echo "Environment:"
env | sort > ENVIRONMENT
echo ${SLURM_NODELIST} > NODES

if [ -L parent ]; then
    CHECKPOINT=""
    ANCESTOR=parent
    while [ -z "$CHECKPOINT" ] && [ -d $ANCESTOR ]; do
        CHECKPOINT=$(find -L $ANCESTOR/rst -name \*.rst 2>/dev/null | awk '{ print length, $0 }' | sort -n  | cut -d" " -f2- | tail -n 1)
        ANCESTOR=$ANCESTOR/parent
    done
    if [ -z "$CHECKPOINT" ]; then
        echo "No checkpoint found in any parent segment, aborting."
        exit 1
    fi
    RESTART="-r $CHECKPOINT -i parfile.par"
    echo "Restarting from $CHECKPOINT:"
else
    RESTART="-i parfile.par time/tlim=0"
    echo "Starting from IC:"
fi

let TOT_NPROCS=${SLURM_JOB_NUM_NODES}*${SLURM_NTASKS_PER_NODE}

$(which mpirun) -np ${TOT_NPROCS} \
    -genv LD_PRELOAD ${SEGFAULT_LIB} -genv SEGFAULT_SIGNALS "segv bus ill fpe abrt" \
    @EXECUTABLE@ \
        --kokkos-map-device-id-by=mpi_rank \
    -t @TERMINATION_TIME@ \
    -d @RUNDIR@ \
    -w 180 \
    $RESTART


echo "Stopping:"
date

echo "Done."
