#!/bin/bash -l
@(#PBS -W depend=afterok:@CHAINED_JOB_ID@)@
#PBS -A @ALLOCATION@
#PBS -q @QUEUE@
#PBS -N @SIMULATION_NAME@
#PBS -l select=@NODES@
#PBS -l walltime=@WALLTIME@
#PBS -l filesystems=flare:home
#PBS -M @EMAIL@
#PBS -m abe
#PBS -k doe
#PBS -o @RUNDIR@/@SIMULATION_NAME@.out
#PBS -e @RUNDIR@/@SIMULATION_NAME@.err
#PBS -l place=scatter

echo "Preparing:"
set -x              # Output commands
set -e              # Abort on errors
cd @RUNDIR@

# Must match the build environment (environment-next.sh): the next-eval compute image
# defaults to PE 26.181.0 / oneAPI 2026.1.0, so without the explicit pin a binary built
# against 26.26.0 would run on the wrong SYCL and FFTW runtimes. On the old image the
# pin is the default anyway, so this is a no-op there.
module load oneapi/release/2025.3.1
module load boost/1.88.0
module load fftw/3.3.10                      # MPI-enabled FFTW3 build

unset FI_LOG_LEVEL   # the next-eval image defaults it to `warn`, which floods the job log

# Set environment
export HOME_KADATH=$HOME/kyoto-initiative/repos/fuka
NTHREADS=@NUM_THREADS@    # Number of OMP threads per rank
NNODES=@NODES@            # Number of Nodes
NRANKS=@NUM_GPUS@         # Number of MPI ranks per node (assume one per GPU)
NTOTRANKS=$(( NNODES * NRANKS ))

# AthenaK packs boundary tags into 20 bits (athena.hpp: 6 bits bufid | 14 bits lid), so it
# needs MPI_TAG_UB >= 1048575. The next-eval compute image defaults to 524287, one bit
# short, and the job dies in the first boundary exchange with "Invalid tag, value is
# 524288". TAG_BITS=21 buys exactly 1048575. Do not add MPIR_CVAR_CH4_OFI_RANK_BITS:
# cxi then rejects the split and every rank aborts in MPI_Init (multi-node only).
export MPIR_CVAR_CH4_OFI_TAG_BITS=21
export MPIR_CVAR_CH4_IPC_GPU_MAX_CACHE_ENTRIES=128
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export OMP_PLACES=threads

CPU_BIND="list:1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100"

echo "Checking:"
pwd
hostname
date

echo "Environment:"
env | sort > ENVIRONMENT
echo "NUM_OF_NODES=${NNODES}  TOTAL_NUM_RANKS=${NTOTRANKS}  RANKS_PER_NODE=${NRANKS}  THREADS_PER_RANK=${NTHREADS}"

# Check for restart files
if [ -d parent/rst ]; then
  restart_files=$(ls -r parent/rst/*.rst)
  restart_file=(${restart_files[0]})
  restart_line="-r $restart_file -i @PARFILE@"
  printf "\nrestarting from $restart_file\n\n"
else
  restart_line="-i @PARFILE@"
  printf "\nstarting from beginning\n\n"
fi

# LORENE Bin_NS initial data stores only the EOS *name* in resu.d; the reader looks it
# up as a bare filename in cwd (see ara-gpu/hunter/lrz-gpu/leonardo-booster templates for
# the same fix). Only needed for lorene_bns runs, but harmless -- and silent -- otherwise
# when BATCH/include has no such file.
if [ -f ../BATCH/include/eos_akmalpr.d ]; then
  ln -sf ../BATCH/include/eos_akmalpr.d .
fi

mpiexec -np $((@NUM_GPUS@ * @NODES@)) \
        -ppn $((@NUM_GPUS@)) \
        --cpu-bind=$CPU_BIND /soft/tools/mpi_wrapper_utils/gpu_tile_compact.sh \
        @EXECUTABLE@ \
        -w @WATCHDOG_TIMEOUT_SECONDS@ \
        -d @RUNDIR@ \
        -t @TERMINATION_TIME@ \
        $restart_line
